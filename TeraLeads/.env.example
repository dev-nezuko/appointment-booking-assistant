# Copy to .env next to docker-compose.yml. Every value has a working default,
# so the stack also starts with no .env at all.

NODE_ENV=development

# Postgres (inside the Compose network the services reach it as postgres:5432)
DB_NAME=chatbot_db
DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_HOST_PORT=5434

# Signs login and chatbot tokens. Use a long random string outside local dev.
JWT_SECRET=change-me-to-a-long-random-string

# auto = a hosted model when its key below is set, the local rule-based model
# otherwise. Leave the keys empty to run fully offline.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Host ports. The browser calls the backend directly, so the NEXT_PUBLIC_*
# URLs and CORS_ORIGIN must match BACKEND_PORT and FRONTEND_PORT. Changing
# NEXT_PUBLIC_* needs a rebuild: they are baked into the frontend bundle.
FRONTEND_PORT=3400
BACKEND_PORT=3401
AI_PORT=8400
CORS_ORIGIN=http://localhost:3400
CORS_ORIGINS=http://localhost:3400
NEXT_PUBLIC_API_URL=http://localhost:3401
NEXT_PUBLIC_WS_URL=ws://localhost:3401
