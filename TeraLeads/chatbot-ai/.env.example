# For running the AI service on its own (python src/main.py).
# auto picks a hosted model when its key is set, otherwise the local model.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data
CORS_ORIGINS=*
